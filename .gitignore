# BeamRunner — the Unity project lives in the BeamRunner/ subfolder, so the Unity patterns
# below are unanchored (they match at any depth). Based on github/gitignore Unity.gitignore.

# --- Unity generated -------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.utmp/
*.log

# MemoryCaptures / Recordings can get excessive in size and may contain sensitive data
[Mm]emoryCaptures/
[Rr]ecordings/

# Blender backup files
*.blend1
*.blend1.meta

# Autogenerated JetBrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Packed Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/BeamRunner/[Aa]ssets/[Ss]treamingAssets/aa*

# --- IDE / solution files (regenerated by Unity) ---------------------------------------------
.vs/
.idea/
.consulo/
.gradle/
ExportedObj/
# (anchored: .csproj/.sln files under tools/ are hand-written and tracked)
/BeamRunner/*.csproj
/BeamRunner/*.unityproj
/BeamRunner/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# --- Builds ----------------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.ipa
*.symbols.zip

# Crashlytics generated file
crashlytics-build.properties

# --- Tooling (tools/) -------------------------------------------------------------------------
tools/**/[Bb]in/
__pycache__/
*.pyc

# --- OS --------------------------------------------------------------------------------------
.DS_Store
Thumbs.db

# Note: BeamRunner/.vscode/ is intentionally tracked (shared editor settings).

# --- Signing keys (never commit; CI takes them from secrets, see docs/CI.md) ------------------
*.keystore
*.jks
*.p12
*.mobileprovision

# --- Crash reporting (Sentry) -----------------------------------------------------------------
# Sentry's CLI options hold the auth token for the debug-symbol upload: keep it local (builds without it skip the upload).
/BeamRunner/Assets/Plugins/Sentry/SentryCliOptions.asset
/BeamRunner/Assets/Plugins/Sentry/SentryCliOptions.asset.meta
